# ==============================================================================
# HabitFlow — .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
build/
.output/
out/

# Environment Variables & Secret Files
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.pfx
*.p12
credentials.json
*service_role*
*service-role*

# Preserve example config
!.env.example

# Logs & Debug Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary & Cache Files
tmp/
temp/
_temp_*
*.tmp
.cache/
.parcel-cache/
.wrangler/

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Local Databases
*.sqlite
*.sqlite3
*.db
