# ==============================================================================
# HabitFlow — Environment Configuration
# ==============================================================================
# Copy this file to .env or configure your environment variables.
# Note: In client-side applications, only the public URL and Anon key are used.
# NEVER expose your SUPABASE_SERVICE_ROLE_KEY in frontend code!

# Supabase Project Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Optional: OAuth Provider Callback URL (Defaults to window.location.origin)
# e.g., http://localhost:3000/dashboard.html or https://habitflow.app/dashboard.html
AUTH_REDIRECT_URL="http://localhost:3000/dashboard.html"
