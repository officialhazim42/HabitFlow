# ==============================================================================
# HabitFlow — Developer Environment Configuration
# ==============================================================================
# Configure this once for the application. Ordinary end users do not need to configure anything.
# Copy this file to .env and supply your project's public anon/publishable key.
# IMPORTANT SECURITY: In browser-based client applications, use ONLY the public project URL
# and the public Anon key. NEVER expose your SUPABASE_SERVICE_ROLE_KEY or sb_secret_*!

# Supabase Project Configuration (Developer Configured)
SUPABASE_URL="https://wzeuroydrorelcxprgew.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Alternative Vite / Bundler naming conventions (also supported)
# VITE_SUPABASE_URL="https://wzeuroydrorelcxprgew.supabase.co"
# VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Optional: OAuth Provider Callback URL (Defaults to window.location.origin)
# e.g., http://localhost:3000/dashboard.html or https://habitflow.app/dashboard.html
AUTH_REDIRECT_URL="http://localhost:3000/dashboard.html"
